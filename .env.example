# LOCAL CONFIGURATION FOR THE UTILITY BILL DECODER
# Copy this file to .env on your own computer. Never submit the real .env.
# This example contains placeholders only and is safe to include in source/.

# Required: Google AI Studio Gemini API key for the Gemini Developer API.
# Get the key from your own AI Studio project. ChatGPT Plus is not an API key.
# The script loads this variable using python-dotenv; no key belongs in Python code.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key

# Optional, with this exact default. The implementation rejects other model IDs.
# This is the ONLY runtime model used for extraction and visual verification.
MODEL_NAME=gemini-3.5-flash-lite

# Provider disclosure metadata only; the program selects Google directly in code.
MODEL_PROVIDER=google

# Operational settings are CLI arguments, not environment variables:
# --pause 12 paces initial runs; --pause 0 is useful for checkpoint-only reruns.
# --cache .cache_test preserves successful test checkpoints locally.
# API temperature 0, structured JSON schema, 120-second request timeout,
# maximum four attempts and bounded exponential backoff are configured in main.py.
# Do not put account IDs, customer information, access tokens or other secrets here.
